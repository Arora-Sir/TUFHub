{
  "manifest_version": 3,
  "name": "TUFHub - TakeUForward GitHub Sync",
  "short_name": "TUFHub",
  "version": "1.0.0",
  "version_name": "1.0.0 - Initial Release",
  "minimum_chrome_version": "111",
  "description": "Automatically sync your TakeUForward (TUF+) accepted solutions to GitHub.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://takeuforward.org/*",
    "https://*.takeuforward.org/*",
    "https://github.com/login/oauth/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://takeuforward.org/plus/*"
      ],
      "js": [
        "scripts/tuf/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://takeuforward.org/plus/*"
      ],
      "js": [
        "scripts/tuf/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png",
      "256": "assets/icons/icon256.png",
      "512": "assets/icons/icon512.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png",
    "256": "assets/icons/icon256.png",
    "512": "assets/icons/icon512.png"
  }
}
